# TransWAF Environment Configuration
# Copy this to .env and fill in your values

# Model Settings
MODEL_CHECKPOINT=models/transwaf_best
MODEL_NAME=distilbert-base-uncased
MAX_SEQ_LENGTH=512

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
CORS_ORIGINS=*

# Database
DATABASE_URL=sqlite+aiosqlite:///./transwaf.db

# Security Thresholds
BLOCK_THRESHOLD=0.80
FLAG_THRESHOLD=0.50

# Training
TRAIN_BATCH_SIZE=32
EVAL_BATCH_SIZE=64
LEARNING_RATE=2e-5
NUM_EPOCHS=5
WARMUP_RATIO=0.1
WEIGHT_DECAY=0.01
MAX_GRAD_NORM=1.0
SEED=42

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/transwaf.log
